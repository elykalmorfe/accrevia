<?xml version="1.0" encoding="utf-8"?>
<!--
  Supplemental App Control policy for Accrevia backend venv native modules.
  Supplements Smart App Control base: VerifiedAndReputableDesktop
  BasePolicyID: {0283ac0f-fff1-49ae-ada1-8a933130cad6}

  Requires:
  - ConfigCI PowerShell module (Windows SDK) for ConvertFrom-CIPolicy
  - Admin rights + CiTool.exe to deploy
  - Option 18 because the venv lives under a user-writable path (Documents)

  Deploy with: .\Deploy-AccreviaVenvAllow.ps1
-->
<SiPolicy xmlns="urn:schemas-microsoft-com:sipolicy" PolicyType="Supplemental Policy">
  <VersionEx>10.0.0.0</VersionEx>
  <PlatformID>{2E07F7E4-194C-4D20-B7C9-6F44A6C5A234}</PlatformID>
  <Rules>
    <Rule>
      <Option>Enabled:Unsigned System Integrity Policy</Option>
    </Rule>
    <Rule>
      <Option>Enabled:Inherit Default Policy</Option>
    </Rule>
    <Rule>
      <Option>Disabled:Runtime FilePath Rule Protection</Option>
    </Rule>
  </Rules>
  <EKUs />
  <FileRules>
    <!-- Allow entire project venv (least privilege vs turning SAC Off) -->
    <Allow ID="ID_ALLOW_ACCREVIA_VENV" FriendlyName="Accrevia backend .venv" FilePath="C:\Users\My Pc\Documents\accrevia\backend\.venv\*" />
  </FileRules>
  <Signers />
  <SigningScenarios>
    <SigningScenario Value="131" ID="ID_SIGNINGSCENARIO_DRIVERS_1" FriendlyName="Kernel mode (unused)">
      <ProductSigners />
    </SigningScenario>
    <SigningScenario Value="12" ID="ID_SIGNINGSCENARIO_WINDOWS" FriendlyName="User mode">
      <ProductSigners>
        <FileRulesRef>
          <FileRuleRef RuleID="ID_ALLOW_ACCREVIA_VENV" />
        </FileRulesRef>
      </ProductSigners>
    </SigningScenario>
  </SigningScenarios>
  <UpdatePolicySigners />
  <CiSigners />
  <HvciOptions>0</HvciOptions>
  <BasePolicyID>{0283ac0f-fff1-49ae-ada1-8a933130cad6}</BasePolicyID>
  <PolicyID>{A1C3E5F7-1928-4B6D-9E0F-1234567890AB}</PolicyID>
  <Settings>
    <Setting Provider="PolicyInfo" Key="Information" ValueName="Name">
      <Value>
        <String>AccreviaBackendVenvAllow</String>
      </Value>
    </Setting>
    <Setting Provider="PolicyInfo" Key="Information" ValueName="Id">
      <Value>
        <String>AccreviaVenv</String>
      </Value>
    </Setting>
  </Settings>
</SiPolicy>
