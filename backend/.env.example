DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (Laragon default: root with empty password on 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=accrevia
MYSQL_USER=root
MYSQL_PASSWORD=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=accrevia_chunks
REDIS_URL=redis://localhost:6379/0
# Set true only for local smoke tests without a Celery worker
CELERY_TASK_ALWAYS_EAGER=false

MEDIA_ROOT=media
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=40
RERANK_TOP_K=12
SEARCH_RESULT_LIMIT=20

# Optional: full path to tesseract.exe on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Hub id or local path (e.g. models/bge-m3 after a one-time download)
BGE_MODEL=BAAI/bge-m3
# Used when FlagEmbedding / BGE-M3 unavailable (ONNX MiniLM)
FASTEMBED_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Dimension for hashed-dense last resort only (native model dims otherwise)
DENSE_VECTOR_SIZE=384
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu
# Optional: Hugging Face token for authenticated model downloads (do not commit real tokens)
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=